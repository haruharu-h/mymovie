# dependencies
node_modules/

# build outputs
dist/
build/

# environment variables
.env
.env.local
.env.*.local
!.env.example

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Docker
.docker/

# Playwright (e2e)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 学習プロジェクトの管理用ファイル（アプリ本体ではないためgit管理外）
/docs/
/notes/
/CLAUDE.md

# インフラのTerraform構成一式。実際のGCPプロジェクトID・サービスアカウント名等が
# 直書きされており、転職活動のポートフォリオとして公開する上で特定の実アカウント情報を
# 出したくないため、ディレクトリごとgit管理外にした（2026-09-16、docs/decisions.md参照）
/infra/

# frontend/.firebaserc: 実際のFirebase/GCPプロジェクトIDが入るためgit管理外。
# frontend/.firebaserc.example をコピーして使う
/frontend/.firebaserc

# .gitleaks.toml: 実際のプロジェクトID・個人メール等をregexパターンとして含むためgit管理外
# （検知ルール自体が漏洩源にならないように）。.gitleaks.toml.example をコピーして使う。
# CI（secret-scan.yml）はGitHub Actionsシークレット(GITLEAKS_CONFIG_TOML)経由で内容を渡す
/.gitleaks.toml
